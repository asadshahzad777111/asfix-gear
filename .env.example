# Copy to .env — never commit .env
NODE_ENV=production
PORT=5000

# MongoDB Atlas (optional — omit to keep JSON file store for local dev)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/asfix_gear?retryWrites=true&w=majority
# MONGODB_DB=asfix_gear

# Comma-separated allowed frontend origins (production CORS only)
# Set on Render dashboard after custom domain — see DOMAIN-SETUP.md
# https://asfixgear.com,https://www.asfixgear.com
CORS_ORIGIN=https://asfixgear.com,https://www.asfixgear.com

# ── Email OTP (Gmail signup / login verification) ──
# Also used for order confirmation + status + completion customer emails.
# Option A (recommended on Render FREE tier — SMTP ports 587/465 are blocked):
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM="AsFix Gear" <noreply@asfixgear.com>   # after verifying domain at resend.com

# Option B: Gmail SMTP (works on Render PAID instance or local dev):
# GMAIL_USER=asadshahzad777111@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM="AsFix Gear" <asadshahzad777111@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="AsFix Gear" <your@gmail.com>

# ── SMS OTP (Twilio) — primary for phone login ──
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── WhatsApp OTP fallback (if SMS fails or not configured) ──
# Twilio WhatsApp:
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OR Meta WhatsApp Cloud API:
# WHATSAPP_TOKEN=your-graph-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Shop WhatsApp for dev manual link fallback (default: 923039227000)
# SHOP_WHATSAPP_INTL=923039227000

# ── Cloudflare R2 (product images — 10 GB free tier) ──
# 1) R2 → Create bucket "asfixgear-images"
# 2) Bucket Settings → Enable Public Development URL → copy pub-xxxxx.r2.dev
# 3) R2 Overview → Manage R2 API Tokens → Object Read & Write on bucket
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=xxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxx
# R2_BUCKET_NAME=asfixgear-images
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ── Render production (copy ALL vars above + below to Render → Environment) ──
# After deploy, verify: https://asfixgear.com/api/health
#   "storage": "mongodb"   ← required (not "json")
#   "r2": "configured"    ← required for photo upload
# Local check: npm run setup:check

# ── n8n automation (optional — see N8N.md + n8n/SETUP-GMAIL-SHEET.md) ──
# Catch-all webhook (order + repair + contact). Use Production URL from n8n Webhook node.
# N8N_WEBHOOK_URL=https://your-n8n.host/webhook/asfix-events
# Optional per-event overrides:
# N8N_WEBHOOK_ORDER=https://your-n8n.host/webhook/asfix-orders
# N8N_WEBHOOK_REPAIR=https://your-n8n.host/webhook/asfix-repairs
# N8N_WEBHOOK_CONTACT=https://your-n8n.host/webhook/asfix-contact
# Optional Google review link used in repair_completed payload for n8n:
# SHOP_GOOGLE_REVIEW_URL=https://g.page/r/xxxx
# Local n8n: docker compose -f docker-compose.n8n.yml up -d → http://localhost:5678
# Live API cannot reach localhost — use n8n Cloud, Railway, or ngrok for Production URL.

# ── Google Sign-In (OAuth 2.0 — free, no SMS needed) ──
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#    Application type: Web application
# 2) Authorized JavaScript origins:
#      https://asfixgear.com
#      https://www.asfixgear.com
#      http://localhost:5173
# 3) Same Client ID on backend (verify token) and frontend (GIS button):
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# ── Frontend (Vite) — set in Vercel / GitHub Pages build env, or frontend/.env ──
# Google Analytics 4 — only loads when set (must start with G-). YOU must create
# the GA4 property and paste your real ID; do not invent one.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# After deploy: Google Search Console → add property → submit
#   https://asfixgear.com/sitemap.xml
#
# API base — default /api (same-origin on Render, or Vite proxy in local dev).
# On Vercel (split deploy), set this to the Render API URL (must include /api):
# VITE_API_BASE=https://asfix-gear.onrender.com/api
# VITE_BASE_PATH=/
#
# Production CORS already allows asfixgear.com, www, GitHub Pages, and https://*.vercel.app
# (see backend/middleware/security.js). Extra origins: add to CORS_ORIGIN above.

# --- PostEx COD courier (Pakistan) ---
# Token from merchant.postex.pk → Setting / Integration Guide (never commit the real token).
# POSTEX_TOKEN=
# Optional override (default: https://api.postex.pk/services/integration/api/order)
# POSTEX_BASE_URL=https://api.postex.pk/services/integration/api/order
# Pickup address code from PostEx get-merchant-address (if you have multiple pickups)
# POSTEX_PICKUP_ADDRESS_CODE=
# Webhook auth — paste same values on merchant.postex.pk Webhook Configuration:
#   Status Updates Webhook URL: https://asfixgear.com/api/webhooks/postex
#   Header Key: x-postex-secret   (or whatever you set below)
#   Header Value: <same as POSTEX_WEBHOOK_SECRET>
# POSTEX_WEBHOOK_HEADER=x-postex-secret
# POSTEX_WEBHOOK_SECRET=generate_a_long_random_string